# Credenziali per il bot LLM. Copia in .env e riempi con le tue.
# Funziona con qualunque endpoint compatibile OpenAI (OpenAI, vLLM, Ollama, ...).
#
#   cp .env.esempio .env && nano .env
#   set -a && source .env && set +a
#   uv run pokelike bot --bot llm --partite 3

FW_ENDPOINT="https://il-tuo-endpoint"   # senza /v1 finale
FW_TOKEN="la-tua-chiave"
MODEL_ID="il-nome-del-modello"
